# Copy this file to .env and fill in only the values needed for your device.
# Never put real account credentials or personal data here.

# Android: use either ANDROID_APP (an APK path) or the installed app's package
# and launch activity. Find a connected device with `adb devices -l`.
ANDROID_DEVICE_NAME=
ANDROID_UDID=
ANDROID_APP=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# iOS: use either IOS_APP (a simulator-compatible .app/.ipa path) or the
# bundle ID of an app already installed on the device/simulator.
# Get simulator names with `xcrun simctl list devices available`.
IOS_DEVICE_NAME=
IOS_UDID=
IOS_PLATFORM_VERSION=
IOS_APP=
IOS_BUNDLE_ID=

# Android selectors discovered on the installed BillEase app. Verify/map the
# corresponding controls separately before running on iOS.
HOME_LOGIN_BUTTON_SELECTOR=android=new UiSelector().resourceId("btn_log_in")
LOGIN_TITLE_SELECTOR=android=new UiSelector().resourceId("ComposeHost_LogInScreen_title")
LOGIN_EMAIL_SELECTOR=android=new UiSelector().resourceId("login_input_email_or_phone")
LOGIN_PASSWORD_SELECTOR=android=new UiSelector().resourceId("login_input_password")
LOGIN_SUBMIT_SELECTOR=android=new UiSelector().resourceId("btn_log_in")
LOGIN_REQUIRED_ERROR_SELECTOR=android=new UiSelector().text("This field is required")
LOGIN_INVALID_EMAIL_ERROR_SELECTOR=
LOGIN_CREDENTIALS_ERROR_SELECTOR=
LOGIN_SUCCESS_DESTINATION_SELECTOR=
LOGIN_PASSWORD_VISIBILITY_TOGGLE_SELECTOR=
LOGIN_SERVER_ERROR_BANNER_SELECTOR=
LOGIN_SERVER_ERROR_ICON_SELECTOR=
LOGIN_DISMISS_SERVER_ERROR_BANNER_SELECTOR=
FORGOT_PASSWORD_LINK_SELECTOR=android=new UiSelector().resourceId("login_link_forgot_password")
LOGIN_LIVE_CHAT_SELECTOR=
LOGIN_LIVE_CHAT_DESTINATION_SELECTOR=
FORGOT_TITLE_SELECTOR=android=new UiSelector().resourceId("ComposeHost_ResetPassword_title")
FORGOT_CONTACT_SELECTOR=android=new UiSelector().resourceId("text_field_contact_to_reset")
FORGOT_SUBMIT_SELECTOR=android=new UiSelector().resourceId("btn_reset")
FORGOT_VALIDATION_ERROR_SELECTOR=android=new UiSelector().text("Please enter a valid email or mobile number.")
SIGN_UP_LINK_SELECTOR=android=new UiSelector().resourceId("login_link_sign_up")
SIGN_UP_TITLE_SELECTOR=android=new UiSelector().text("Let’s get started")
