{
  "name": "billease-mobile-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Appium JavaScript starter for safe Android and iOS BillEase UI testing",
  "scripts": {
    "appium": "appium --address 127.0.0.1",
    "test": "wdio run ./wdio.conf.js",
    "test:android": "cross-env PLATFORM=android wdio run ./wdio.conf.js",
    "test:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.js"
  },
  "devDependencies": {
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.20.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "webdriverio": "^10.1.0"
  }
}
